# Add this block to the Caddyfile your existing Caddy container already
# reads (the same one serving kitoblarim), then reload Caddy — it will
# request/renew the Let's Encrypt certificate for sarvarlogs.uz automatically.

sarvarlogs.uz {
    reverse_proxy my-blog-app:80
}

# Reload without downtime, from wherever your Caddy compose file lives:
#   docker exec <caddy-container-name> caddy reload --config /etc/caddy/Caddyfile
