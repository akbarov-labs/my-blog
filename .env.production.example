# Copy this to `.env` in the deploy directory ON THE SERVER (not in the repo)
# and fill in real values. Generate APP_KEY once with:
#   docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"

APP_NAME="Sarvar Akbarov"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sarvarlogs.uz

LOG_CHANNEL=stack
LOG_LEVEL=error

# SQLite — no separate database container needed. Must be an absolute path
# under storage/, which is the volume that survives deploys.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
